# Long browser cache for the Lottie animations (1 year).
# Safe, because the Blade component appends ?v=<file modification time> to the URL:
# a replaced JSON file gets a new URL, so the browser downloads it again.

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.json$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
